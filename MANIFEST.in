include requirements.txt
recursive-include meganorm *.py
recursive-include meganorm/layouts *.json

include pyproject.toml CITATION.cff
include tools/sync_metadata.py

include CHANGELOG.md RELEASE.md CONTRIBUTING.md
include docs/requirements.txt
graft docs/source
